# Ayuva Environment Configuration
# Copy to .env and customize for production or live LLM providers.

# Database URL (defaults to local SQLite ./data/ayuva.db if unset)
# For PostgreSQL: postgresql+psycopg2://postgres:password@localhost:5432/ayuva
DATABASE_URL=

# JWT signing secret (use a strong 32+ character random secret in production)
SECRET_KEY=replace-with-a-strong-random-secret-key

# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Maximum uploaded document size in MB
MAX_UPLOAD_SIZE_MB=10

# Google Gemini API Configuration (required for AI Healthcare Assistant)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
LLM_MODEL=gemini-flash-latest

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
